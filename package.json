    "@vercel/blob": "^2.8.2",
    "better-auth": "^1.7.13",
    "codemirror": "^6.0.2",
    "framer-motion": "^12.38.0",
    "kysely": "^0.29.7",
    "nanoid": "^5.1.16",
    "next": "^16.4.3",
    "pg": "^8.23.1",
