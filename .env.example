# Optional: send feedback form submissions to Discord.
DISCORD_FEEDBACK_WEBHOOK_URL=

# Optional: public avatar and account-media hosting (Vercel Blob).
# Avatar uploads also require KV below for rate limits.
BLOB_READ_WRITE_TOKEN=

# Optional: expiring share links and avatar upload rate limits in Cloudflare KV.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_KV_NAMESPACE_ID=
CLOUDFLARE_API_TOKEN=

# Optional: Google Search Console HTML-tag verification token.
GOOGLE_SITE_VERIFICATION=

# Optional public integrations. Configure your own IDs; neither is a secret.
NEXT_PUBLIC_UMAMI_WEBSITE_ID=
NEXT_PUBLIC_ADOBE_FONTS_KIT_ID=

# Discord sign-in sessions/dashboard. Development uses private .data/ SQLite and a generated local secret.
# Production requires persistent PostgreSQL and an explicit stable secret and URL.
DATABASE_URL=
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=

# Required for Discord-only account sign-in, including local development.
# Callback: <BETTER_AUTH_URL>/api/auth/callback/discord
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Meowhook bot. Interactions endpoint: <BETTER_AUTH_URL>/api/discord/interactions/<application-id>
DISCORD_APPLICATION_ID=
DISCORD_PUBLIC_KEY=
DISCORD_BOT_TOKEN=

# Vercel invokes the authenticated schedule worker every minute (a plan supporting minute crons is required).
CRON_SECRET=
